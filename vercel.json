{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "routes": [
    {
      "src": "/",
      "dest": "/landing-maxx.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/app/?",
      "dest": "/app/index.html"
    },
    {
      "src": "/api/para11ax/(.*)",
      "dest": "/api/para11ax/[...path].js"
    },
    {
      "src": "/403",
      "dest": "/403.html",
      "status": 403
    },
    {
      "src": "/500",
      "dest": "/500.html",
      "status": 500
    },
    {
      "src": "/.*",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
